# Dependencies
node_modules/

# Wrangler's scratch directory — regenerated on every local build.
.wrangler/

# NOTE: dist/ is deliberately tracked. The Cloudflare Pages project serves
# `pages_build_output_dir`, and committing the build keeps a deploy working
# whether or not Pages is configured to run `npm run build` itself.

# Environment / secrets
.env
.env.*
.dev.vars

# KV sync temp files
.kv-*.tmp
.kv-*.tmp.json

# Editors
.vscode/
.idea/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
