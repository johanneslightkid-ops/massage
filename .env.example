# ---------------------------------------------------------------------------
# Ola Serena — environment template.
# Copy to `.env` (git-ignored) and fill in. Nothing here is a real credential.
# ---------------------------------------------------------------------------

# --- Cloudflare: KV content sync -------------------------------------------
# Required by `npm run sync:kv` and by the `postbuild` hook (which skips the
# sync silently when these two are absent, e.g. on a plain local build).
# Token needs the "Workers KV Storage: Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# KV namespace ids. Optional — both default to the id in wrangler.toml.
KV_NAMESPACE_ID=
KV_NAMESPACE_PREVIEW_ID=

# Set to 1 to overwrite content keys that already exist in KV.
# Unset/0 leaves existing values alone (the default, idempotent behaviour).
FORCE=

# --- Cloudinary: signed image uploads --------------------------------------
# Cloud name and API key are public and are also exposed to the browser via
# GET /api/uploads/config. Without all three the admin image field reports
# `configured: false` and falls back to inline WebP data-URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# NEVER commit the secret. In production set it as a Pages secret instead:
#   npx wrangler pages secret put CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# --- Test / tooling scripts ------------------------------------------------
# `npm run test:e2e` and `npm run test:seo`; defaults to http://127.0.0.1:8788
BASE_URL=

# Explicit Chromium binary for the Playwright-driven scripts above and
# `npm run og`. Leave blank to use Playwright's bundled browser.
CHROMIUM_PATH=

# --- Open Graph image generation (`npm run og`) ----------------------------
# All optional; each falls back to the studio branding baked into the script.
OG_BRAND=
OG_MARK=
OG_LINE=
OG_TAG=
