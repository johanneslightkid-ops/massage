{
  "name": "ola-serena",
  "version": "1.0.0",
  "description": "Tropical massage studio site for Los Corales, B\u00e1varo \u2014 React + Vite on Cloudflare Pages with KV-backed CMS.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cf:dev": "npm run build && wrangler pages dev",
    "cf:deploy": "npm run build && wrangler pages deploy",
    "sync:kv": "node scripts/sync-kv.mjs",
    "sync:kv:preview": "node scripts/sync-kv.mjs preview",
    "postbuild": "node -e \"if(process.env.CLOUDFLARE_API_TOKEN&&process.env.CLOUDFLARE_ACCOUNT_ID){require('child_process').execSync('node scripts/sync-kv.mjs',{stdio:'inherit'})}else{console.log('[postbuild] skipping KV sync (CLOUDFLARE_API_TOKEN / _ACCOUNT_ID not set)')}\"",
    "seed": "node scripts/seed-kv.mjs",
    "seed:preview": "node scripts/seed-kv.mjs preview",
    "test:e2e": "node scripts/e2e.mjs",
    "test:seo": "node scripts/seo-check.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johanneslightkid-ops/massage.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/johanneslightkid-ops/massage/issues"
  },
  "homepage": "https://github.com/johanneslightkid-ops/massage#readme",
  "dependencies": {
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  },
  "type": "module",
  "private": true
}
